SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndwbnVjbnNlanFtcWd0eGRyd250Iiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImlhdCI6MTc1NDg4OTYwOCwiZXhwIjoyMDcwNDY1NjA4fQ.eVJn8uw5tne2VTAvHHw3OJ83AoVcC_p2vgypFK5BPZ4

# =================================================================
# REDIS CONFIGURATION
# =================================================================
REDIS_URL=redis://localhost:6379

# =================================================================
# AI SERVICE CONFIGURATION
# =================================================================
# OpenAI API Key (required for code generation)
OPENAI_API_KEY=sk-proj-your-openai-api-key-here

# Anthropic API Key (optional, for Claude integration)
ANTHROPIC_API_KEY=your-anthropic-api-key-here

# =================================================================
# GITHUB INTEGRATION
# =================================================================
# GitHub OAuth App credentials
GITHUB_CLIENT_ID=your_github_client_id_here
GITHUB_CLIENT_SECRET=your_github_client_secret_here
GITHUB_REDIRECT_URI=http://localhost:4000/auth/github/callback

# =================================================================
# VERCEL INTEGRATION (Optional)
# =================================================================
# Vercel API Token for deployment
VERCEL_API_TOKEN=your_vercel_api_token_here
VERCEL_TEAM_ID=your_vercel_team_id_here

# =================================================================
# SERVICE PORTS
# =================================================================
# Frontend (Next.js)
WEB_PORT=3000

# Orchestrator API
ORCHESTRATOR_PORT=4000

# Preview Service
PREVIEW_SERVICE_PORT=4001

# =================================================================
# CORS CONFIGURATION
# =================================================================
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:4000,http://localhost:4001

# =================================================================
# DEVELOPMENT CONFIGURATION
# =================================================================
NODE_ENV=development
WORKER_CONCURRENCY=1

# =================================================================
# PREVIEW SERVICE CONFIGURATION
# =================================================================
PREVIEW_BASE_DIRECTORY=/tmp/celiador-previews
PREVIEW_CLEANUP_INTERVAL=1800000

# =================================================================
# STRIPE CONFIGURATION (Optional - for subscriptions)
# =================================================================
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here
STRIPE_PUBLISHABLE_KEY=pk_test_your_stripe_publishable_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# =================================================================
# EMAIL CONFIGURATION (Optional)
# =================================================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# =================================================================
# LOGGING CONFIGURATION
# =================================================================
LOG_LEVEL=debug
LOG_FORMAT=json
