// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projects Project[]
  jobs     Job[]

  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  
  // Audit fields
  creator   String?
  updater   String?
  updatedAt DateTime @default(now())
  deleter   String?
  deletedAt DateTime?
  
  // Basic profile information
  username  String?  @unique
  fullName  String?  @map("full_name")
  website   String?
  avatarURL String?  @map("avatar_url")
  
  // Detailed name components
  namePrefix   String? @map("name_prefix")
  firstName    String? @map("first_name")
  middleName   String? @map("middle_name")
  preLastName  String? @map("pre_last_name")
  lastName     String? @map("last_name")
  nameSuffix   String? @map("name_suffix")
  
  // Contact information
  phoneNumber String? @map("phone_number")
  personalId  String? @map("personal_id")
  email       String? @unique
  role        String? @default("user") // 'user', 'admin', 'super'
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  @@map("profiles")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  templateKey String   @default("next-prisma-supabase")
  status      String   @default("READY") // READY, RUNNING, FAILED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Repository info
  repoProvider String @default("github")
  repoOwner    String
  repoName     String

  // Environment variables (stored as JSON)
  env Json?

  // Audit fields
  creator   String?
  updater   String?
  deleter   String?
  deletedAt DateTime?

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs   Job[]

  @@map("projects")
}

model Job {
  id        String   @id @default(cuid())
  type      String   // SCAFFOLD, EDIT, TEST, DEPLOY
  status    String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED
  prompt    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Job result data
  output   String?
  error    String?
  metadata Json? // Stored as JSON

  // Audit fields
  creator   String?
  updater   String?
  deleter   String?
  deletedAt DateTime?

  // Relations
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("jobs")
}
