// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  projects Project[]
  jobs     Job[]
  conversations Conversation[]
  messages Message[]
  githubIntegration GitHubIntegration?
  serviceIntegrations ServiceIntegration[]

  @@map("users")
}

model Profile {
  id        String   @id @default(cuid())
  
  // Audit fields
  creator   String?
  updater   String?
  updatedAt DateTime @default(now())
  deleter   String?
  deletedAt DateTime?
  
  // Basic profile information
  username  String?  @unique
  fullName  String?  @map("full_name")
  website   String?
  avatarURL String?  @map("avatar_url")
  
  // Detailed name components
  namePrefix   String? @map("name_prefix")
  firstName    String? @map("first_name")
  middleName   String? @map("middle_name")
  preLastName  String? @map("pre_last_name")
  lastName     String? @map("last_name")
  nameSuffix   String? @map("name_suffix")
  
  // Contact information
  phoneNumber String? @map("phone_number")
  personalId  String? @map("personal_id")
  email       String? @unique
  role        String? @default("user") // 'user', 'admin', 'super'
  
  // Timestamps
  createdAt DateTime @default(now()) @map("created_at")

  @@map("profiles")
}

model Project {
  id          String   @id @default(cuid())
  name        String
  templateKey String   @default("next-prisma-supabase")
  status      String   @default("READY") // READY, RUNNING, FAILED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Repository info
  repoProvider String @default("github")
  repoOwner    String
  repoName     String

  // Environment variables (stored as JSON)
  env Json?

  // Audit fields
  creator   String?
  updater   String?
  deleter   String?
  deletedAt DateTime?

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobs   Job[]
  conversations Conversation[]
  conversationContexts ConversationContext[]

  @@map("projects")
}

model Job {
  id        String   @id @default(cuid())
  type      String   // SCAFFOLD, EDIT, TEST, DEPLOY
  status    String   @default("PENDING") // PENDING, RUNNING, COMPLETED, FAILED, CANCELLED
  prompt    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Job result data
  output   String?
  error    String?
  metadata Json? // Stored as JSON

  // Audit fields
  creator   String?
  updater   String?
  deleter   String?
  deletedAt DateTime?

  // Relations
  projectId String
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  relatedMessages Message[]

  @@map("jobs")
}

// Conversation models for chat functionality
model Conversation {
  id          String   @id @default(cuid())
  title       String?  // Optional conversation title
  status      String   @default("ACTIVE") // ACTIVE, ARCHIVED, DELETED
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  // Context linking
  projectId   String?   @map("project_id") // Optional - conversations can be project-specific or global
  project     Project?  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId      String    @map("user_id")
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Audit fields matching existing pattern
  creator     String?
  updater     String?
  deleter     String?
  deletedAt   DateTime? @map("deleted_at")

  // Relations
  messages    Message[]
  contexts    ConversationContext[]
  
  @@map("conversations")
}

// Individual messages within conversations
model Message {
  id            String   @id @default(cuid())
  content       String   // The actual message text
  role          String   // "user", "assistant", "system"
  messageType   String   @default("text") @map("message_type") // "text", "command", "file_reference", "job_result"
  createdAt     DateTime @default(now()) @map("created_at")

  // Context and metadata
  metadata      Json?    // Store additional context, file references, job IDs, etc.
  parentId      String?  @map("parent_id") // For threaded conversations
  parent        Message? @relation("MessageThread", fields: [parentId], references: [id])
  children      Message[] @relation("MessageThread")

  // Linking to existing job system
  relatedJobId  String?  @map("related_job_id") // Link messages to jobs they triggered
  relatedJob    Job?     @relation(fields: [relatedJobId], references: [id])

  // Relations
  conversationId String      @map("conversation_id")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  userId         String      @map("user_id")
  user           User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("messages")
}

// AI context management for maintaining project understanding
model ConversationContext {
  id              String   @id @default(cuid())
  contextType     String   @map("context_type") // "project_summary", "file_knowledge", "user_preferences"
  contextData     Json     @map("context_data") // Vector embeddings, summaries, preferences
  lastUpdated     DateTime @default(now()) @map("last_updated")
  
  // Linking
  conversationId  String      @map("conversation_id")
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  projectId       String?     @map("project_id")
  project         Project?    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  
  @@map("conversation_contexts")
}

// Enhanced GitHub integration data (extends existing project repoProvider/repoOwner/repoName)
model GitHubIntegration {
  id            String   @id @default(cuid())
  accessToken   String   @map("access_token") // Encrypted GitHub access token
  refreshToken  String?  @map("refresh_token") // For token refresh
  scope         String[] // GitHub OAuth scopes
  installationId String? @map("installation_id") // GitHub App installation ID
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  
  // Link to existing user system
  userId        String   @unique @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("github_integrations")
}

// Track external service integrations
model ServiceIntegration {
  id          String   @id @default(cuid())
  service     String   // "openai", "anthropic", "vercel", etc.
  config      Json     // Service-specific configuration
  status      String   @default("ACTIVE") // ACTIVE, DISABLED, ERROR
  lastSync    DateTime? @map("last_sync")
  createdAt   DateTime @default(now()) @map("created_at")
  
  // Link to user
  userId      String   @map("user_id") 
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  @@map("service_integrations")
}
